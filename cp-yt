def ffmpeg(): return shutil.which("ffmpeg") or sys.exit("ffmpeg not found")
def ffprobe(): return shutil.which("ffprobe") or sys.exit("ffprobe not found")


def run(cmd, check=True):
    p = subprocess.run(cmd, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, text=True)
    if check and p.returncode != 0:
        raise RuntimeError(f"cmd failed: {' '.join(map(str, cmd))}\n{p.stderr[-3000:]}")
    return p


def probe_stream(path, stream=None, entries="format=duration"):
    cmd = [ffprobe(), "-v", "error", "-of", "default=nw=1",
           "-show_entries", entries]
    if stream:
        cmd += ["-select_streams", stream]
    cmd += [str(path)]
    out = subprocess.check_output(cmd, text=True)
    d = {}
    for line in out.strip().splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            d[k] = v
    return d


def video_info(path):
    v = probe_stream(path, stream="v:0",
                     entries="stream=width,height,r_frame_rate,nb_frames,duration")
    w = int(v.get("width", 0))
    h = int(v.get("height", 0))
    fr = v.get("r_frame_rate", "30/1")
    try:
        num, den = fr.split("/")
        fps = float(num) / float(den)
    except Exception:
        fps = 30.0
    dur = float(v.get("duration") or
                probe_stream(path).get("duration", 0.0))
    return {"width": w, "height": h, "fps": fps, "duration": dur}


def extract_audio_wav(video, wav_path, sr=48000):
    run([ffmpeg(), "-y", "-i", str(video),
         "-vn", "-ac", "2", "-ar", str(sr),
         "-acodec", "pcm_s16le", str(wav_path)])


def read_frame(path, t, target_w=None, target_h=None):
    cap = cv2.VideoCapture(str(path))
    cap.set(cv2.CAP_PROP_POS_MSEC, t * 1000.0)
    ok, frame = cap.read()
    cap.release()
    if not ok:
        return None
    if target_w and target_h:
        frame = cv2.resize(frame, (target_w, target_h),
                           interpolation=cv2.INTER_AREA)
    return cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)


