#!/usr/bin/env python3
"""
ytcr_gui — manual selection YouTube copyright remover
====================================================
Interactive tool:
  - scrub video timeline
  - mark audio time ranges to mutate (or all)
  - draw video regions to mutate (or all)
  - per-selection strength
  - render

Requires:
    pip install numpy opencv-python pillow
    ffmpeg + ffprobe on PATH

Run:
    python ytcr_gui.py
"""

