class WaveformCanvas(tk.Canvas):
    """Displays an audio waveform thumbnail with draggable selection ranges."""

    def __init__(self, master, on_range_added=None, **kw):
        super().__init__(master, bg="#1a1a1a", height=120,
                         highlightthickness=0, **kw)
        self.wave = None       # np array mono, downsampled
        self.sr_disp = None
        self.duration = 0.0
        self.on_range_added = on_range_added
        self.ranges = []       # list of (start, end, color)
        self._drag_start = None
        self.bind("<Configure>", lambda e: self.redraw())
        self.bind("<Button-1>", self._on_press)
        self.bind("<B1-Motion>", self._on_drag)
        self.bind("<ButtonRelease-1>", self._on_release)

    def set_waveform(self, mono, sr):
        self.wave = mono
        self.sr_disp = sr
        self.duration = len(mono) / sr if sr else 0.0
        self.redraw()

    def add_range(self, start, end, color="#3aa0ff"):
        self.ranges.append((start, end, color))
        self.redraw()

    def clear_ranges(self):
        self.ranges.clear()
        self.redraw()

    def _x_to_t(self, x):
        w = self.winfo_width() or 1
        return max(0.0, min(self.duration, x / w * self.duration))

    def _t_to_x(self, t):
        w = self.winfo_width() or 1
        return int(t / self.duration * w) if self.duration else 0

    def _on_press(self, e):
        self._drag_start = self._x_to_t(e.x)

    def _on_drag(self, e):
        if self._drag_start is None:
            return
        self.redraw(temp_end=self._x_to_t(e.x))

    def _on_release(self, e):
        if self._drag_start is None:
            return
        end = self._x_to_t(e.x)
        s, en = sorted((self._drag_start, end))
        self._drag_start = None
        if en - s > 0.05:
            if self.on_range_added:
                self.on_range_added(s, en)
        self.redraw()

    def redraw(self, temp_end=None):
        self.delete("all")
        w = self.winfo_width() or 1
        h = self.winfo_height() or 1
        # baseline
        self.create_line(0, h // 2, w, h // 2, fill="#333")
        # waveform
        if self.wave is not None and len(self.wave) > 0:
            n = w
            step = max(1, len(self.wave) // n)
            ys = []
            xs = []
            for i in range(n):
                seg = self.wave[i * step:(i + 1) * step]
                if len(seg) == 0:
                    continue
                amp = float(np.max(np.abs(seg)))
                xs.append(i)
                ys.append(amp)
            for x, a in zip(xs, ys):
                y1 = h // 2 - int(a * (h // 2 - 4))
                y2 = h // 2 + int(a * (h // 2 - 4))
                self.create_line(x, y1, x, y2, fill="#5a5a5a")
        # ranges
        for (s, e, c) in self.ranges:
            x1 = self._t_to_x(s)
            x2 = self._t_to_x(e)
            self.create_rectangle(x1, 0, x2, h, fill=c, stipple="gray25",
                                  outline=c)
        # temp drag
        if self._drag_start is not None and temp_end is not None:
            s, en = sorted((self._drag_start, temp_end))
            x1 = self._t_to_x(s)
            x2 = self._t_to_x(en)
            self.create_rectangle(x1, 0, x2, h, fill="#3aa0ff",
                                  stipple="gray50", outline="#3aa0ff")


class VideoCanvas(tk.Canvas):
    """Displays a video frame; lets user draw selection rectangles."""

    def __init__(self, master, on_region_added=None, **kw):
        super().__init__(master, bg="#000", highlightthickness=0, **kw)
        self.img_ref = None
        self.frame_bgr = None
        self.video_size = (0, 0)     # original video px
        self.disp_size = (0, 0)      # displayed size
        self.offset = (0, 0)
        self.on_region_added = on_region_added
        self.regions = []            # list of (x,y,w,h,color)
        self._drag = None
        self.bind("<Configure>", lambda e: self.redraw())
        self.bind("<Button-1>", self._on_press)
        self.bind("<B1-Motion>", self._on_drag)
        self.bind("<ButtonRelease-1>", self._on_release)

    def set_frame(self, rgb_frame):
        self.frame_bgr = rgb_frame
        self.video_size = (rgb_frame.shape[1], rgb_frame.shape[0])
        self.redraw()

    def add_region(self, x, y, w, h, color="#3aa0ff"):
        self.regions.append((x, y, w, h, color))
        self.redraw()

    def clear_regions(self):
        self.regions.clear()
        self.redraw()

    def _compute_fit(self):
        cw = self.winfo_width() or 1
        ch = self.winfo_height() or 1
        vw, vh = self.video_size
        if not vw or not vh:
            return 1.0, 0, 0
        scale = min(cw / vw, ch / vh)
        dw = int(vw * scale)
        dh = int(vh * scale)
        ox = (cw - dw) // 2
        oy = (ch - dh) // 2
        self.disp_size = (dw, dh)
        self.offset = (ox, oy)
        return scale, ox, oy

    def _canvas_to_video(self, x, y):
        scale, ox, oy = self._compute_fit()
        vx = int((x - ox) / scale) if scale else 0
        vy = int((y - oy) / scale) if scale else 0
        vw, vh = self.video_size
        vx = max(0, min(vw, vx))
        vy = max(0, min(vh, vy))
        return vx, vy

    def _on_press(self, e):
        self._drag = self._canvas_to_video(e.x, e.y)

    def _on_drag(self, e):
        if not self._drag:
            return
        cur = self._canvas_to_video(e.x, e.y)
        self.redraw(temp_rect=(self._drag, cur))

    def _on_release(self, e):
        if not self._drag:
            return
        cur = self._canvas_to_video(e.x, e.y)
        x0, y0 = self._drag
        x1, y1 = cur
        self._drag = None
        x, y = min(x0, x1), min(y0, y1)
        w, h = abs(x1 - x0), abs(y1 - y0)
        if w > 8 and h > 8:
            if self.on_region_added:
                self.on_region_added(x, y, w, h)
        self.redraw()

    def redraw(self, temp_rect=None):
        self.delete("all")
        cw = self.winfo_width() or 1
        ch = self.winfo_height() or 1
        if self.frame_bgr is None:
            self.create_text(cw // 2, ch // 2, fill="#666",
                             text="load a video to preview")
            return
        scale, ox, oy = self._compute_fit()
        dw, dh = self.disp_size
        pil = Image.fromarray(self.frame_bgr)
        if (dw, dh) != (pil.width, pil.height):
            pil = pil.resize((dw, dh), Image.LANCZOS)
        self.img_ref = ImageTk.PhotoImage(pil)
        self.create_image(ox, oy, anchor="nw", image=self.img_ref)
        # regions
        for (x, y, w, h, c) in self.regions:
            cx = ox + int(x * scale)
            cy = oy + int(y * scale)
            cw_ = int(w * scale)
            ch_ = int(h * scale)
            self.create_rectangle(cx, cy, cx + cw_, cy + ch_,
                                  outline=c, width=2)
        if temp_rect:
            (x0, y0), (x1, y1) = temp_rect
            cx = ox + int(min(x0, x1) * scale)
            cy = oy + int(min(y0, y1) * scale)
            cw_ = int(abs(x1 - x0) * scale)
            ch_ = int(abs(y1 - y0) * scale)
            self.create_rectangle(cx, cy, cx + cw_, cy + ch_,
                                  outline="#3aa0ff", width=2, dash=(4, 2))


