# audio mutation core (mirrors ytcr.py)
# ---------------------------------------------------------------------------

def load_wav(path):
    import wave
    with wave.open(str(path), "rb") as w:
        sr = w.getframerate()
        n = w.getnframes()
        ch = w.getnchannels()
        raw = w.readframes(n)
    data = np.frombuffer(raw, dtype=np.int16).reshape(-1, ch)
    return data.astype(np.float32) / 32768.0, sr


def save_wav(path, data, sr):
    import wave
    d = np.clip(data, -1.0, 1.0)
    pcm = (d * 32767.0).astype(np.int16)
    with wave.open(str(path), "wb") as w:
        w.setnchannels(pcm.shape[1])
        w.setsampwidth(2)
        w.setframerate(sr)
        w.writeframes(pcm.tobytes())


def _stft(x, n_fft=2048, hop=512):
    win = np.hanning(n_fft).astype(np.float32)
    n = 1 + (len(x) - n_fft) // hop
    frames = np.empty((n, n_fft), dtype=np.complex64)
    for i in range(n):
        seg = x[i * hop: i * hop + n_fft] * win
        frames[i] = np.fft.rfft(seg, n=n_fft)
    return frames, win


def _istft(frames, win, hop, length):
    n_fft = (frames.shape[1] - 1) * 2
    out = np.zeros(length, dtype=np.float32)
    norm = np.zeros(length, dtype=np.float32)
    wsum = win ** 2
    for i in range(frames.shape[0]):
        seg = np.fft.irfft(frames[i], n=n_fft).astype(np.float32) * win
        s = i * hop
        if s + n_fft > length:
            break
        out[s: s + n_fft] += seg
        norm[s: s + n_fft] += wsum
    norm[norm < 1e-8] = 1.0
    return out / norm


def _eq_notch(x, sr, centers=(400, 1000, 2500, 6000), depth_db=-3.0, q=1.2):
    frames, win = _stft(x)
    freqs = np.fft.rfftfreq(2048, 1.0 / sr)
    gain = np.ones_like(freqs, dtype=np.float32)
    for c in centers:
        bw = c / q
        mask = np.exp(-0.5 * ((freqs - c) / (bw / 2.0)) ** 2)
        gain *= 10 ** ((depth_db / 20.0) * mask)
    frames *= gain[None, :]
    return _istft(frames, win, 512, len(x))


def _resample(data, sr_in, sr_out):
    if sr_in == sr_out:
        return data
    n_out = int(len(data) * sr_out / sr_in)
    idx = np.linspace(0, len(data) - 1, n_out)
    out = np.empty((n_out, data.shape[1]), dtype=np.float32)
    for ch in range(data.shape[1]):
        out[:, ch] = np.interp(idx, np.arange(len(data)), data[:, ch])
    return out


def _pitch_shift_mono(x, sr, semitones):
    if abs(semitones) < 1e-4:
        return x
    rate = 2 ** (semitones / 12.0)
    n_fft, hop_a = 2048, 512
    hop_s = int(round(hop_a / rate))
    frames, win = _stft(x, n_fft, hop_a)
    mag = np.abs(frames)
    phase = np.angle(frames)
    omega0 = 2 * np.pi * hop_a * np.fft.rfftfreq(n_fft, 1.0 / sr)[None, :]
    dphi = np.diff(phase, axis=0, prepend=phase[:1])
    dphi = np.mod(dphi - omega0 + np.pi, 2 * np.pi) - np.pi
    omega = omega0 + dphi
    out_len = int(len(x) / rate) + n_fft
    out = np.zeros(out_len, dtype=np.float32)
    norm = np.zeros(out_len, dtype=np.float32)
    wsum = win ** 2
    acc = phase[:1].copy()
    for i in range(frames.shape[0]):
        if i > 0:
            acc = acc + omega[i]
        seg = np.fft.irfft(mag[i] * np.exp(1j * acc), n=n_fft).astype(np.float32) * win
        s = i * hop_s
        if s + n_fft > out_len:
            break
        out[s: s + n_fft] += seg
        norm[s: s + n_fft] += wsum
    norm[norm < 1e-8] = 1.0
    return (out / norm)[:out_len]


def _time_stretch_mono(x, sr, rate):
    if abs(rate - 1.0) < 1e-4:
        return x
    n_fft, hop_a = 2048, 512
    hop_s = int(round(hop_a / rate))
    frames, win = _stft(x, n_fft, hop_a)
    mag = np.abs(frames)
    phase = np.angle(frames)
    omega0 = 2 * np.pi * hop_a * np.fft.rfftfreq(n_fft, 1.0 / sr)[None, :]
    dphi = np.diff(phase, axis=0, prepend=phase[:1])
    dphi = np.mod(dphi - omega0 + np.pi, 2 * np.pi) - np.pi
    omega = omega0 + dphi
    out_len = int(len(x) / rate) + n_fft
    out = np.zeros(out_len, dtype=np.float32)
    norm = np.zeros(out_len, dtype=np.float32)
    wsum = win ** 2
    acc = phase[:1].copy()
    for i in range(frames.shape[0]):
        if i > 0:
            acc = acc + omega[i]
        seg = np.fft.irfft(mag[i] * np.exp(1j * acc), n=n_fft).astype(np.float32) * win
        s = i * hop_s
        if s + n_fft > out_len:
            break
        out[s: s + n_fft] += seg
        norm[s: s + n_fft] += wsum
    norm[norm < 1e-8] = 1.0
    return (out / norm)[:out_len]


def mutate_audio_segment(seg, sr, preset_name):
    """seg: float32 (samples, channels). returns mutated same-shape block."""
    preset = PRESETS[preset_name]
    out_ch = []
    # micro stereo phase
    if seg.shape[1] == 2:
        d = int(sr * 0.15 / 1000.0)
        if d > 0:
            s2 = seg.copy()
            s2[d:, 1] = seg[:-d, 1]
            s2[:d, 1] = seg[:d, 1]
            seg = s2
    for ch in range(seg.shape[1]):
        x = seg[:, ch]
        x = _eq_notch(x, sr)
        x = _pitch_shift_mono(x, sr, preset["pitch"] * 0.5)
        x = _time_stretch_mono(x, sr, 1.0 + preset["tempo"] / 100.0)
        out_ch.append(x)
    L = min(len(c) for c in out_ch)
    out = np.stack([c[:L] for c in out_ch], axis=1)
    out = _resample(out, sr, 44100)
    out = _resample(out, 44100, sr)
    amp = 10 ** (preset["noise"] / 20.0)
    noise = np.random.randn(*out.shape).astype(np.float32) * amp
    k = np.ones(8, dtype=np.float32) / 8.0
    for ch in range(noise.shape[1]):
        noise[:, ch] = np.convolve(noise[:, ch], k, mode="same")
    out = out + noise
    # resample back to seg length so caller can splice it in
    if len(out) != len(seg):
        idx = np.linspace(0, len(out) - 1, len(seg))
        out2 = np.empty((len(seg), out.shape[1]), dtype=np.float32)
        for ch in range(out.shape[1]):
            out2[:, ch] = np.interp(idx, np.arange(len(out)), out[:, ch])
        out = out2
    return np.clip(out, -1.0, 1.0)


# ---------------------------------------------------------------------------
# video filtergraph builder
# ---------------------------------------------------------------------------

def build_video_filtergraph(regions, full_frame_preset, width, height, duration):
    """
    Returns (filter_complex_string, output_label).
    Regions = list of VideoRegion (0<=start<=end<=duration).
    full_frame_preset: preset name or None.
    Time-bounded regions via enable='between(t,s,e)'.
    """
    parts = []
    labels = []
    # start with input
    if full_frame_preset is None and not regions:
        return None, "[0:v]"
    p = PRESETS[full_frame_preset] if full_frame_preset else None

    # base stream = input
    parts.append("[0:v]split=%d[base0]" % (len(regions) + 1))
    base_labels = [f"[base{i}]" for i in range(len(regions) + 1)]
    # apply full-frame if requested on base0
    chain = "[base0]"
    if full_frame_preset:
        vf = _full_frame_chain(p, width, height)
        parts.append(f"[base0]{vf}[vfull]")
        chain = "[vfull]"
    else:
        parts.append("[base0]null[vfull]")
        chain = "[vfull]"

    # now overlay each region's mutated crop onto vfull
    for i, r in enumerate(regions):
        pres = PRESETS[r.preset]
        zoom = 1.0 + pres["zoom"] / 100.0
        zw = int(r.w * zoom) // 2 * 2
        zh = int(r.h * zoom) // 2 * 2
        cx = (zw - r.w) // 2
        cy = (zh - r.h) // 2
        rotate = pres["rotate"] * np.pi / 180.0
        gamma = 1.0 + pres["gamma"]
        bright = pres["bright"]
        enable = ""
        if r.end > r.start >= 0:
            enable = f":enable='between(t,{r.start:.3f},{r.end:.3f})'"

        reg_in = f"[base{i+1}]"
        # crop region -> mutate -> overlay
        mutate_chain = (
            f"crop={r.w}:{r.h}:{r.x}:{r.y},"
            f"scale={zw}:{zh}:flags=lanczos,"
            f"crop={r.w}:{r.h}:{cx}:{cy},"
            f"rotate={rotate}:ow={r.w}:oh={r.h}:c=black@0,"
            f"eq=gamma={gamma:.4f}:brightness={bright:.4f}"
        )
        parts.append(f"{reg_in}{mutate_chain}[reg{i}]")
        # overlay onto current chain
        ovl_out = f"[v{i}]"
        parts.append(
            f"{chain}[reg{i}]overlay={r.x}:{r.y}{enable}{ovl_out}"
        )
        chain = ovl_out

    # final
    return ";".join(parts), chain


def _full_frame_chain(p, w, h):
    zoom = 1.0 + p["zoom"] / 100.0
    crop = p["crop"]
    rotate = p["rotate"] * np.pi / 180.0
    zw = int(w * zoom) // 2 * 2
    zh = int(h * zoom) // 2 * 2
    cx = (zw - w) // 2
    cy = (zh - h) // 2
    cw = (w - 2 * crop) // 2 * 2
    ch = (h - 2 * crop) // 2 * 2
    gamma = 1.0 + p["gamma"]
    bright = p["bright"]
    fps = f",fps=fps={30 + p['fps']*0.01}:round=up" if p["fps"] > 0 else ""
    return (
        f"scale={zw}:{zh}:flags=lanczos,"
        f"crop={w}:{h}:{cx}:{cy},"
        f"rotate={rotate}:ow={w}:oh={h}:c=black@0,"
        f"crop={cw}:{ch}:{(w-cw)//2}:{(h-ch)//2},"
        f"scale={w}:{h}:flags=lanczos,"
        f"eq=gamma={gamma:.4f}:brightness={bright:.4f}"
        f"{fps}"
    )


# ---------------------------------------------------------------------------
# render pipeline
# ---------------------------------------------------------------------------

def render_project(project: Project, progress_cb=None):
    input_path = Path(project.input_path)
    output_path = Path(project.output_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    if not input_path.exists():
        raise RuntimeError(f"input not found: {input_path}")

    info = video_info(input_path)
    duration = info["duration"]
    width, height = info["width"], info["height"]

    with tempfile.TemporaryDirectory(prefix="ytcr_gui_") as td:
        td = Path(td)

        # ---- AUDIO STAGE ------------------------------------------------
        if progress_cb: progress_cb("audio: decode")
        wav_in = td / "a_in.wav"
        wav_out = td / "a_out.wav"
        extract_audio_wav(input_path, wav_in, sr=48000)
        data, sr = load_wav(wav_in)

        if project.mutate_all_audio:
            if progress_cb: progress_cb("audio: mutate all")
            data = mutate_audio_segment(data, sr, project.all_audio_preset)
        else:
            for i, r in enumerate(project.audio_ranges):
                if progress_cb: progress_cb(f"audio: range {i+1}/{len(project.audio_ranges)}")
                s = max(0, int(r.start * sr))
                e = min(len(data), int(r.end * sr))
                if e <= s:
                    continue
                seg = data[s:e]
                # preserve original stereo width by mutating each ch
                mut = mutate_audio_segment(seg, sr, r.preset)
                data[s:e] = mut

        save_wav(wav_out, data, sr)

        # ---- VIDEO STAGE ------------------------------------------------
        if progress_cb: progress_cb("video: build filtergraph")
        regions = [r for r in project.video_regions
                   if 0 <= r.x and 0 <= r.y and r.w > 0 and r.h > 0]
        fg, out_label = build_video_filtergraph(
            regions,
            project.all_video_preset if project.mutate_all_video else None,
            width, height, duration
        )

        vid_mut = td / "v_mut.mp4"
        if fg is None:
            # no video changes; copy video stream
            run([ffmpeg(), "-y", "-i", str(input_path),
                 "-an", "-c:v", "copy", str(vid_mut)])
        else:
            cmd = [ffmpeg(), "-y", "-i", str(input_path),
                   "-filter_complex", fg,
                   "-map", out_label.lstrip("[").rstrip("]"),
                   "-an", "-c:v", "libx264", "-preset", "slow",
                   "-crf", "20", "-pix_fmt", "yuv420p",
                   str(vid_mut)]
            if progress_cb: progress_cb("video: encode")
            run(cmd)

        # ---- MUX --------------------------------------------------------
        if progress_cb: progress_cb("mux")
        run([ffmpeg(), "-y",
             "-i", str(vid_mut),
             "-i", str(wav_out),
             "-c:v", "copy",
             "-c:a", "aac", "-b:a", "256k", "-ar", "48000",
             "-shortest", "-movflags", "+faststart",
             str(output_path)])

    if progress_cb: progress_cb("done")
    return str(output_path)


