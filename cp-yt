PRESETS = {
    "subtle":     dict(pitch=0.8, tempo=0.3, noise=-58, rotate=0.3,
                       zoom=1.5, crop=2, gamma=0.01, bright=0.01, fps=0),
    "balanced":   dict(pitch=1.8, tempo=0.7, noise=-52, rotate=0.7,
                       zoom=2.5, crop=4, gamma=0.02, bright=0.02, fps=1),
    "aggressive": dict(pitch=3.0, tempo=1.2, noise=-46, rotate=1.2,
                       zoom=4.0, crop=6, gamma=0.03, bright=0.03, fps=2),
}

VIDEO_EXTS = {".mp4", ".mkv", ".mov", ".webm", ".avi", ".m4v"}


# ---------------------------------------------------------------------------
# data model
# ---------------------------------------------------------------------------

@dataclass
class AudioRange:
    start: float
    end: float
    preset: str = "balanced"

@dataclass
class VideoRegion:
    x: int
    y: int
    w: int
    h: int
    preset: str = "balanced"
    start: float = 0.0
    end: float = -1.0   # -1 = full duration

@dataclass
class Project:
    input_path: str = ""
    output_path: str = ""
    audio_ranges: List[AudioRange] = field(default_factory=list)
    video_regions: List[VideoRegion] = field(default_factory=list)
    mutate_all_audio: bool = False
    mutate_all_video: bool = False
    all_audio_preset: str = "balanced"
    all_video_preset: str = "balanced"

    def to_json(self):
        d = asdict(self)
        return json.dumps(d, indent=2)

    @classmethod
    def from_json(cls, s):
        d = json.loads(s)
        p = cls(
            input_path=d.get("input_path", ""),
            output_path=d.get("output_path", ""),
            mutate_all_audio=d.get("mutate_all_audio", False),
            mutate_all_video=d.get("mutate_all_video", False),
            all_audio_preset=d.get("all_audio_preset", "balanced"),
            all_video_preset=d.get("all_video_preset", "balanced"),
        )
        for r in d.get("audio_ranges", []):
            p.audio_ranges.append(AudioRange(**r))
        for r in d.get("video_regions", []):
            p.video_regions.append(VideoRegion(**r))
        return p


