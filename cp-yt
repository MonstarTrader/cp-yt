    def _bind_keys(self):
        self.bind("<Control-o>", lambda e: self.open_video())
        self.bind("<Control-s>", lambda e: self.set_output())
        self.bind("<Left>", lambda e: self._step_scrub(-0.5))
        self.bind("<Right>", lambda e: self._step_scrub(0.5))
        self.bind("<space>", lambda e: self._step_scrub(0.0))

    # ---------- project actions -----------------------------------

    def open_video(self):
        p = filedialog.askopenfilename(
            filetypes=[("video", " ".join(f"*{e}" for e in VIDEO_EXTS)),
                       ("all", "*.*")]
        )
        if not p:
            return
        self.project.input_path = p
        self.lbl_input.config(text=Path(p).name)
        if not self.project.output_path:
            op = str(Path(p).with_name(Path(p).stem + "__ytcr" + Path(p).suffix))
            self.project.output_path = op
            self.lbl_output.config(text=Path(op).name)

        self._load_media()

    def set_output(self):
        if not self.project.input_path:
            messagebox.showinfo("no input", "open a video first")
            return
        p = filedialog.asksaveasfilename(
            defaultextension=".mp4",
            initialfile=Path(self.project.input_path).stem + "__ytcr.mp4",
            filetypes=[("mp4", "*.mp4"), ("mkv", "*.mkv")]
        )
        if not p:
            return
        self.project.output_path = p
        self.lbl_output.config(text=Path(p).name)

    def _load_media(self):
        path = self.project.input_path
        self.status.config(text="loading media...")
        self.update_idletasks()
        try:
            self.info = video_info(path)
        except Exception as e:
            messagebox.showerror("probe failed", str(e))
            return
        self.slider.config(to=int(self.info["duration"] * 1000))
        self.lbl_time.config(
            text=f"0.00 / {self.info['duration']:.2f}"
        )
        # audio thumbnail
        try:
            with tempfile.TemporaryDirectory() as td:
                wav = Path(td) / "a.wav"
                extract_audio_wav(path, wav, sr=16000)
                d, sr = load_wav(wav)
                mono = d.mean(axis=1)
                # downsample thumbnail to ~4000 bins
                target = 4000
                if len(mono) > target:
                    step = len(mono) // target
                    mono = np.array([
                        float(np.max(np.abs(mono[i*step:(i+1)*step])))
                        for i in range(target)
                    ], dtype=np.float32)
                    # re-add sign so canvas has shape — use raw here
                self.audio_thumb = mono
                self.wave_canvas.set_waveform(self.audio_thumb,
                                              sr=sr * max(1, step if len(d) > target else 1))
        except Exception as e:
            print("audio preview failed:", e)
        # first frame
        self._update_frame(0.0)
        self.status.config(text="ready")

    def _update_frame(self, t):
        if not self.info:
            return
        cw = max(64, self.video_canvas.winfo_width())
        ch = max(64, self.video_canvas.winfo_height())
        try:
            frame = read_frame(self.project.input_path, t,
                               target_w=cw, target_h=ch)
        except Exception as e:
            print("frame read failed:", e)
            frame = None
        if frame is not None:
            self.video_canvas.set_frame(frame)
        self.lbl_time.config(text=f"{t:.2f} / {self.info['duration']:.2f}")

    def _on_scrub(self, value):
        t = float(value) / 1000.0
        self._update_frame(t)

    def _step_scrub(self, delta):
        cur = self.slider.get() / 1000.0
        t = max(0.0, min(self.info["duration"] if self.info else 0.0,
                         cur + delta))
        self.slider.set(int(t * 1000))

    # ---------- selection callbacks -------------------------------

    def _on_audio_range_drawn(self, start, end):
        preset = self.var_audio_preset.get()
        r = AudioRange(start=start, end=end, preset=preset)
        self.project.audio_ranges.append(r)
        color = {"subtle": "#3aa0ff",
                 "balanced": "#ffb03a",
                 "aggressive": "#ff4a4a"}[preset]
        self.wave_canvas.add_range(start, end, color)
        self.ar_list.insert("end",
                            f"[{start:.2f} - {end:.2f}]  {preset}")

    def _on_video_region_drawn(self, x, y, w, h):
        preset = self.var_video_preset.get()
        r = VideoRegion(x=x, y=y, w=w, h=h, preset=preset)
        self.project.video_regions.append(r)
        color = {"subtle": "#3aa0ff",
                 "balanced": "#ffb03a",
                 "aggressive": "#ff4a4a"}[preset]
        self.video_canvas.add_region(x, y, w, h, color)
        self.vr_list.insert("end",
                            f"({x},{y}) {w}x{h}  {preset}")

    # ---------- list operations -----------------------------------

    def _edit_audio_range(self, _evt):
        sel = self.ar_list.curselection()
        if not sel:
            return
        i = sel[0]
        r = self.project.audio_ranges[i]
        dlg = PresetDialog(self, current=r.preset,
                           label=f"range {r.start:.2f}-{r.end:.2f}")
        if dlg.result:
            r.preset = dlg.result
            self.ar_list.delete(i)
            self.ar_list.insert(i,
                                f"[{r.start:.2f} - {r.end:.2f}]  {r.preset}")
            # recolor waveform
            self.wave_canvas.ranges[i] = (
                r.start, r.end,
                {"subtle": "#3aa0ff", "balanced": "#ffb03a",
                 "aggressive": "#ff4a4a"}[r.preset]
            )
            self.wave_canvas.redraw()

    def _delete_audio_range(self):
        sel = self.ar_list.curselection()
        if not sel:
            return
        i = sel[0]
        del self.project.audio_ranges[i]
        del self.wave_canvas.ranges[i]
        self.ar_list.delete(i)
        self.wave_canvas.redraw()

    def _clear_audio_ranges(self):
        self.project.audio_ranges.clear()
        self.wave_canvas.clear_ranges()
        self.ar_list.delete(0, "end")

    def _edit_video_region(self, _evt):
        sel = self.vr_list.curselection()
        if not sel:
            return
        i = sel[0]
        r = self.project.video_regions[i]
        dlg = PresetDialog(self, current=r.preset,
                           label=f"region {r.w}x{r.h} @ ({r.x},{r.y})")
        if dlg.result:
            r.preset = dlg.result
            self.vr_list.delete(i)
            self.vr_list.insert(i,
                                f"({r.x},{r.y}) {r.w}x{r.h}  {r.preset}")
            self.video_canvas.regions[i] = (
                r.x, r.y, r.w, r.h,
                {"subtle": "#3aa0ff", "balanced": "#ffb03a",
                 "aggressive": "#ff4a4a"}[r.preset]
            )
            self.video_canvas.redraw()

    def _delete_video_region(self):
        sel = self.vr_list.curselection()
        if not sel:
            return
        i = sel[0]
        del self.project.video_regions[i]
        del self.video_canvas.regions[i]
        self.vr_list.delete(i)
        self.video_canvas.redraw()

    def _clear_video_regions(self):
        self.project.video_regions.clear()
        self.video_canvas.clear_regions()
        self.vr_list.delete(0, "end")

    def _sync_all_flags(self):
        self.project.mutate_all_audio = self.var_all_audio.get()
        self.project.mutate_all_video = self.var_all_video.get()
        self.project.all_audio_preset = self.var_audio_preset.get()
        self.project.all_video_preset = self.var_video_preset.get()

    # ---------- save/load ----------------------------------------

    def save_project(self):
        p = filedialog.asksaveasfilename(defaultextension=".ytcr.json",
                                          filetypes=[("ytcr project", "*.json")])
        if not p:
            return
        self._sync_all_flags()
        Path(p).write_text(self.project.to_json())
        self.status.config(text=f"saved: {p}")

    def load_project(self):
        p = filedialog.askopenfilename(filetypes=[("ytcr project", "*.json")])
        if not p:
            return
        try:
            self.project = Project.from_json(Path(p).read_text())
        except Exception as e:
            messagebox.showerror("load failed", str(e))
            return
        self.lbl_input.config(text=Path(self.project.input_path).name)
        self.lbl_output.config(text=Path(self.project.output_path).name)
        self.var_all_audio.set(self.project.mutate_all_audio)
        self.var_all_video.set(self.project.mutate_all_video)
        self.var_audio_preset.set(self.project.all_audio_preset)
        self.var_video_preset.set(self.project.all_video_preset)
        # refresh lists
        self.ar_list.delete(0, "end")
        self.wave_canvas.clear_ranges()
        for r in self.project.audio_ranges:
            self.ar_list.insert("end",
                                f"[{r.start:.2f} - {r.end:.2f}]  {r.preset}")
            self.wave_canvas.add_range(
                r.start, r.end,
                {"subtle": "#3aa0ff", "balanced": "#ffb03a",
                 "aggressive": "#ff4a4a"}[r.preset]
            )
        self.vr_list.delete(0, "end")
        self.video_canvas.clear_regions()
        for r in self.project.video_regions:
            self.vr_list.insert("end",
                                f"({r.x},{r.y}) {r.w}x{r.h}  {r.preset}")
            self.video_canvas.add_region(
                r.x, r.y, r.w, r.h,
                {"subtle": "#3aa0ff", "balanced": "#ffb03a",
                 "aggressive": "#ff4a4a"}[r.preset]
            )
        if self.project.input_path:
            self._load_media()

    # ---------- render -------------------------------------------

    def render(self):
        if not self.project.input_path:
            messagebox.showinfo("no input", "open a video first")
            return
        if not self.project.output_path:
            self.set_output()
        self._sync_all_flags()

        def worker():
            try:
                def cb(msg):
                    self.status.config(text=msg)
                    self.update_idletasks()
                render_project(self.project, progress_cb=cb)
                self.status.config(text="done ✓")
                messagebox.showinfo("render", "render complete")
            except Exception as e:
                traceback.print_exc()
                self.status.config(text=f"error: {e}")
                messagebox.showerror("render failed", str(e))

        threading.Thread(target=worker, daemon=True).start()


class PresetDialog(tk.Toplevel):
    def __init__(self, master, current="balanced", label=""):
        super().__init__(master)
        self.title("preset")
        self.configure(bg="#111")
        self.result = None
        tk.Label(self, text=label, bg="#111", fg="#ccc").pack(padx=12, pady=6)
        self.var = tk.StringVar(value=current)
        for k in PRESETS.keys():
            tk.Radiobutton(self, text=k, value=k, variable=self.var,
                           bg="#111", fg="#ddd", selectcolor="#222",
                           activebackground="#111").pack(anchor="w", padx=18)
        btns = tk.Frame(self, bg="#111")
        btns.pack(pady=8)
        tk.Button(btns, text="ok", command=self._ok,
                  bg="#2b5fd9", fg="#fff", relief="flat").pack(side="left", padx=4)
        tk.Button(btns, text="cancel", command=self.destroy,
                  bg="#222", fg="#eee", relief="flat").pack(side="left", padx=4)
        self.transient(master)
        self.grab_set()

    def _ok(self):
        self.result = self.var.get()
        self.destroy()


